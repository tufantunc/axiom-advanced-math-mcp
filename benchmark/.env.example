# ── Anthropic (Claude) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── z.ai (GLM models) ─────────────────────────────────
ZAI_API_KEY=...
# ZAI_BASE_URL=https://api.z.ai/v1       # optional, this is the default

# ── OpenRouter (hundreds of models) ───────────────────
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # optional
# OPENROUTER_SITE_URL=https://your-site.com         # optional, for rankings
# OPENROUTER_APP_NAME=My Benchmark                  # optional, for rankings

# ── MCP server command (override if needed) ───────────
# MCP_SERVER_CMD=tsx ../src/cli.ts    # default when running locally
# MCP_SERVER_CMD=tsx /app/src/cli.ts  # default inside Docker

# ── Local models (LM Studio, Ollama, etc.) ─────────────
LOCAL_BASE_URL=http://localhost:1234/v1    # LM Studio default
# LOCAL_BASE_URL=http://localhost:11434/v1  # Ollama default
# LOCAL_API_KEY=not-needed                  # optional, rarely needed
